{
  "name": "paralibazaar",
  "version": "1.0.0",
  "private": true,
  "description": "ParaliBazaar — a marketplace connecting Punjab farmers with buyers of paddy stubble, so it never gets burned. UN SDG 13: Climate Action.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "stop": "bash scripts/stop-node.sh",
    "stop:all": "bash scripts/stop-node.sh --all",
    "stop:dry": "bash scripts/stop-node.sh --dry-run",
    "assets": "python scripts/optimise_assets.py",
    "check:i18n": "node scripts/audit-translations.cjs",
    "gen:i18n": "node scripts/gen-data-translations.cjs",
    "deploy": "npm run build && next start"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
